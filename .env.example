# Copy to .env for local runs. On GitHub, add these as repository secrets instead.
# Any channel left blank is simply skipped.

# Telegram (recommended): token from @BotFather, then run `python3 scraper.py --telegram-chat-id`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (optional): Gmail address + a Gmail "App password" (not your normal password)
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# WhatsApp via CallMeBot (optional): https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
